{
  "info": {
    "_postman_id": "f1a2b3c4-7d8e-4f9a-ab2c-3d4e5f6a7b8c",
    "name": "CI Type Catalog Service - TypeDefinition Lifecycle Suite",
    "description": "Enterprise-grade E2E Postman Suite for the CI Type Catalog Service Domain (BIAN-aligned, ADR-001/005/013/019/030/031/032). Covers the TypeDefinition lifecycle under /ci-type-catalog/v1 (initiate, retrieve, update, control/activate, control/deactivate, active-schema/retrieve), the audit ledger, the one-ACTIVE-per-category invariant, mandatory X-Tenant-Id/X-Executor auditing, RFC 7807 error_code assertions (400/404/409) and W3C traceparent correlation. Requires an organisationId environment variable populated from the Party Reference Data Directory Service Domain.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "39879181"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically generate standard W3C traceparent (ADR-010) and X-Trace-Id",
          "function generateHex(len) {",
          "    let result = '';",
          "    const chars = '0123456789abcdef';",
          "    for (let i = 0; i < len; i++) {",
          "        result += chars.charAt(Math.floor(Math.random() * chars.length));",
          "    }",
          "    return result;",
          "}",
          "const traceId = generateHex(32);",
          "const spanId = generateHex(16);",
          "const traceparent = `00-${traceId}-${spanId}-01`;",
          "pm.request.headers.upsert({ key: 'traceparent', value: traceparent });",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: traceId });",
          "pm.environment.set('currentTraceId', traceId);"
        ]
      }
    }
  ],
